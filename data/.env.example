# Never commit the real key. The default scorer uses the OpenAI Responses API.
OPENAI_API_KEY=
PCC_SCORING_MODEL=gpt-5.4-mini

# Alternative: connect your backend scorer. It must read one JSON request from
# stdin and print one JSON result matching scripts/score_paper_auto.py.
# PCC_SCORER_COMMAND=python3 path/to/your_scorer.py
