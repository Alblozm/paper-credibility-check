{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark_manifest.schema.json",
  "title": "Pipeline manifest",
  "type": "object",
  "required": ["manifest_version", "target_paper_count", "papers"],
  "properties": {
    "manifest_version": {"type": "string", "minLength": 1},
    "target_paper_count": {"type": "integer", "minimum": 1},
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["paper_id", "version", "source_type", "source_url", "title", "enabled"],
        "properties": {
          "paper_id": {"type": "string", "pattern": "^paper_[0-9]{3,}$"},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"},
          "source_type": {"enum": ["arxiv", "openreview", "pdf"]},
          "source_url": {"type": "string", "pattern": "^https?://"},
          "title": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
